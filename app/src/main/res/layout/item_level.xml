<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de nivel: número en círculo de color, nombre, dificultad y botón de jugar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/levelNumber"
        style="@style/Eargym.Text.Title"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:textColor="@color/eg_ink"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/levelName"
            style="@style/Eargym.Text.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Nivel 1 · Fácil" />

        <TextView
            android:id="@+id/levelDetail"
            style="@style/Eargym.Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="@dimen/text_small"
            tools:text="Diferencia de ±50 cents" />
    </LinearLayout>

    <ImageView
        android:id="@+id/levelPlay"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_play"
        app:tint="@color/eg_ink" />
</LinearLayout>
