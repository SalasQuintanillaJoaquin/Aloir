<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".PianoActivity">

    <include layout="@layout/view_title_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.55"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/Eargym.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estás tocando" />

        <TextView
            android:id="@+id/pianoNote"
            style="@style/Eargym.Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="—"
            android:textColor="@color/eg_neon"
            android:textSize="@dimen/text_score" />

        <TextView
            android:id="@+id/pianoFreq"
            style="@style/Eargym.Text.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Toca una tecla" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pianoDown"
                style="@style/Eargym.Button.Outline"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:minWidth="0dp"
                android:contentDescription="Bajar una octava"
                android:padding="0dp"
                android:text="−"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/pianoOctave"
                style="@style/Eargym.Text.Subtitle"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Octava 4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pianoUp"
                style="@style/Eargym.Button.Outline"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:minWidth="0dp"
                android:contentDescription="Subir una octava"
                android:padding="0dp"
                android:text="+"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <com.miempresa.aloir.ui.PianoView
        android:id="@+id/pianoKeys"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.45"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp" />
</LinearLayout>
