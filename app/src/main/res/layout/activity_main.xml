<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/menuColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <ImageView
                android:id="@+id/menuLogo"
                android:layout_width="match_parent"
                android:layout_height="@dimen/logo_height"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_eargym_neon" />

            <TextView
                android:id="@+id/menuTitle"
                style="@style/Eargym.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/escucha_y_aprende" />

            <TextView
                android:id="@+id/menuTagline"
                style="@style/Eargym.Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/tagline" />

            <LinearLayout
                android:id="@+id/menuButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnJugar"
                    style="@style/Eargym.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/jugar"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExtras"
                    style="@style/Eargym.Button.Menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/mas_ejercicios"
                    app:icon="@drawable/ic_music_note"
                    app:iconTint="@color/eg_violet" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPiano"
                    style="@style/Eargym.Button.Menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/piano"
                    app:icon="@drawable/ic_piano"
                    app:iconTint="@color/eg_blue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcercade"
                    style="@style/Eargym.Button.Menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/acerca_de"
                    app:icon="@drawable/ic_info"
                    app:iconTint="@color/eg_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalir"
                    style="@style/Eargym.Button.Menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/salir"
                    app:icon="@drawable/ic_exit"
                    app:iconTint="@color/eg_red" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
