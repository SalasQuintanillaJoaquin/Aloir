<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".QuizActivity">

    <include layout="@layout/view_title_bar" />

    <ProgressBar
        android:id="@+id/quizProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:max="100"
        android:progressDrawable="@drawable/progress_neon" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <TextView
                    android:id="@+id/quizQuestion"
                    style="@style/Eargym.Text.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/eg_neon"
                    tools:text="¿Qué intervalo escuchas?" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/quizListen"
                            style="@style/Eargym.Button"
                            android:layout_width="104dp"
                            android:layout_height="104dp"
                            android:contentDescription="Escuchar"
                            android:padding="0dp"
                            app:backgroundTint="@color/eg_blue"
                            app:cornerRadius="100dp"
                            app:icon="@drawable/ic_volume"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="48dp" />

                        <TextView
                            style="@style/Eargym.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:importantForAccessibility="no"
                            android:text="Escuchar" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="28dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/quizSlow"
                            style="@style/Eargym.Button"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:contentDescription="Escuchar más lento"
                            android:padding="0dp"
                            app:backgroundTint="@color/eg_surface_high"
                            app:cornerRadius="100dp"
                            app:icon="@drawable/ic_replay"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="32dp"
                            app:iconTint="@color/eg_text" />

                        <TextView
                            style="@style/Eargym.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:importantForAccessibility="no"
                            android:text="Más lento" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/quizOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_panel"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            style="@style/Eargym.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ejercicio" />

                        <TextView
                            android:id="@+id/quizCounter"
                            style="@style/Eargym.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="1/10" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_panel"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            style="@style/Eargym.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/puntaje" />

                        <TextView
                            android:id="@+id/quizScore"
                            style="@style/Eargym.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/eg_neon"
                            tools:text="0" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
